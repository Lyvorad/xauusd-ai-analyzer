# === IA ===
GEMINI_API_KEY=

# === Precio de oro (usa las que tengas, el sistema ignora las que falten) ===
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=
GOLDAPI_API_KEY=
FINNHUB_API_KEY=

# === Noticias ===
MARKETAUX_API_KEY=
NEWSAPI_API_KEY=
GNEWS_API_KEY=

# === Base de datos ===
# En local puedes dejarlo así (SQLite, no requiere nada instalado):
DATABASE_URL=sqlite:///./local.db
# En Render usarás la URL que te da su Postgres administrado, ej:
# DATABASE_URL=postgresql://usuario:password@host:5432/nombre_db

# === Seguridad / control de uso ===
# Segundos mínimos entre dos consultas manuales del mismo cliente (anti-abuso)
COOLDOWN_CONSULTA_MANUAL=120
